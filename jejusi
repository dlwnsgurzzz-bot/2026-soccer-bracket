                            <div class="mt-8 p-4 bg-amber-50 border border-amber-200 rounded-2xl text-center animate-bounce">
                                <i class="fa-solid fa-trophy text-amber-500 text-3xl mb-1"></i>
                                <div class="text-xs font-bold text-amber-800 uppercase tracking-wider">CHAMPION</div>
                                <div class="text-xl font-black text-amber-950 mt-0.5">${champion}</div>
                            </div>
                        ` : ''}
                    </div>
                </div>
            `;
        }

        // Render Tournament Knockout Section (Semis / Final)
        function renderKnockoutSection(catKey) {
            const ko = appState[catKey].knockout;
            const isMidM = catKey === 'mid_m';

            let html = `
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden">
                    <div class="bg-slate-800 text-white px-5 py-4">
                        <h3 class="font-bold flex items-center gap-2 text-base">
                            <i class="fa-solid fa-sitemap text-amber-400"></i> ${isMidM ? '본선 토너먼트 (준결승 & 결승)' : '최종 결승전'}
                        </h3>
                        <p class="text-xs text-slate-300 mt-0.5">조별 리그 1위 팀이 자동으로 토너먼트 대진표에 배치됩니다.</p>
                    </div>
                    <div class="p-6">
            `;

            if (isMidM) {
                html += `
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        ${renderKnockoutCard(catKey, 'semi1', ko.semi1)}
                        ${renderKnockoutCard(catKey, 'semi2', ko.semi2)}
                    </div>
                    <div class="border-t border-slate-200 pt-6 max-w-xl mx-auto">
                        <h4 class="text-center font-extrabold text-slate-700 text-base mb-4 flex items-center justify-center gap-2">
                            <i class="fa-solid fa-trophy text-amber-500"></i> 남중부 결승전
                        </h4>
                        ${renderKnockoutCard(catKey, 'final', ko.final, true)}
                    </div>
                `;
            } else {
                html += `
                    <div class="max-w-xl mx-auto py-2">
                        ${renderKnockoutCard(catKey, 'final', ko.final, true)}
                    </div>
                `;
            }

            html += `
                    </div>
                </div>
            `;

            return html;
        }

        // Single Knockout Match Card Template
        function renderKnockoutCard(catKey, matchKey, match, isFinal = false) {
            const valA = match.scoreA !== null ? match.scoreA : '';
            const valB = match.scoreB !== null ? match.scoreB : '';

            let winner = null;
            if (match.completed && match.scoreA !== null && match.scoreB !== null) {
                const sa = parseInt(match.scoreA);
                const sb = parseInt(match.scoreB);
                if (sa > sb) winner = match.teamA;
                else if (sb > sa) winner = match.teamB;
                else winner = "승부차기 필요";
            }

            return `
                <div class="bg-slate-50 rounded-xl p-4 border ${isFinal ? 'border-amber-300 bg-amber-50/30' : 'border-slate-200'} shadow-sm">
                    <div class="text-xs font-bold ${isFinal ? 'text-amber-800' : 'text-slate-500'} mb-3 text-center">
                        ${match.name}
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-3">
                        <input type="date" value="${match.matchDate || ''}" onchange="updateMatchSchedule('${match.id}', 'date', this.value)" class="w-full px-2.5 py-2 text-xs bg-white border border-slate-300 rounded-lg">
                        <input type="time" value="${match.matchTime || ''}" onchange="updateMatchSchedule('${match.id}', 'time', this.value)" class="w-full px-2.5 py-2 text-xs bg-white border border-slate-300 rounded-lg">
                    </div>
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex-1 text-right min-w-0"><div class="text-[10px] font-extrabold text-blue-600">HOME</div><span class="font-extrabold text-sm text-slate-800 block truncate">${match.teamA}</span></div>
                        <div class="flex items-center gap-1.5 bg-white px-2.5 py-1.5 rounded-xl border border-slate-300 shadow-inner">
                            <input type="number" min="0" max="99" value="${valA}" 
                                onchange="updateKnockoutScore('${catKey}', '${matchKey}', this.value, true)"
                                placeholder="0" 
                                class="w-9 text-center font-extrabold text-base bg-transparent text-emerald-700 focus:outline-none">
                            <span class="text-slate-400 font-bold text-xs">:</span>
                            <input type="number" min="0" max="99" value="${valB}" 
                                onchange="updateKnockoutScore('${catKey}', '${matchKey}', this.value, false)"
                                placeholder="0" 
                                class="w-9 text-center font-extrabold text-base bg-transparent text-emerald-700 focus:outline-none">
                        </div>
                        <div class="flex-1 text-left min-w-0"><div class="text-[10px] font-extrabold text-rose-600">AWAY</div><span class="font-extrabold text-sm text-slate-800 block truncate">${match.teamB}</span></div>
                    </div>
                    ${winner ? `
                        <div class="mt-3 text-center text-xs font-bold ${isFinal ? 'text-amber-900 bg-amber-200/60' : 'text-emerald-800 bg-emerald-100'} py-1 px-2 rounded-lg">
                            ${isFinal ? '🏆 최종 우승: ' : '승자 진출: '} ${winner}
                        </div>
                    ` : ''}
                </div>
            `;
        }

        // Handler: Update match schedule (date / time)
        function updateMatchSchedule(matchId, field, value) {
            let target = null;

            if (currentCategory === 'elem_m') {
                target = appState.elem_m.matches.find(m => m.id === matchId);
            } else if (currentCategory === 'elem_w') {
                target = appState.elem_w.finalMatch;
            } else if (currentCategory === 'mid_m' || currentCategory === 'mid_w') {
                appState[currentCategory].groups.forEach(g => {
                    const found = g.matches.find(m => m.id === matchId);
                    if (found) target = found;
                });
                if (!target) {
                    const ko = appState[currentCategory].knockout;
                    target = Object.values(ko).find(m => m.id === matchId) || null;
                }
            }

            if (!target) return;
            if (field === 'date') target.matchDate = value;
            if (field === 'time') target.matchTime = value;
            saveAppState();
            showToast("경기 일정이 저장되었습니다.");
        }

        // Handler: Update group league score
        function updateMatchScore(matchId, value, isTeamA) {
            const scoreVal = value.trim() === '' ? null : parseInt(value);

            if (currentCategory === 'elem_m') {
                const match = appState.elem_m.matches.find(m => m.id === matchId);
                if (match) {
                    if (isTeamA) match.scoreA = scoreVal;
                    else match.scoreB = scoreVal;
                    match.completed = (match.scoreA !== null && match.scoreB !== null);
                }
            } else if (currentCategory === 'mid_m' || currentCategory === 'mid_w') {
                appState[currentCategory].groups.forEach(g => {
                    const match = g.matches.find(m => m.id === matchId);
                    if (match) {
                        if (isTeamA) match.scoreA = scoreVal;
                        else match.scoreB = scoreVal;
                        match.completed = (match.scoreA !== null && match.scoreB !== null);
                    }
                });
            }

            saveAppState();
            renderView();
            showToast("경기 결과가 저장되었습니다.");
        }

        // Handler: Update knockout match score
        function updateKnockoutScore(catKey, matchKey, value, isTeamA) {
            const scoreVal = value.trim() === '' ? null : parseInt(value);

            if (catKey === 'elem_w') {
                const m = appState.elem_w.finalMatch;
                if (isTeamA) m.scoreA = scoreVal;
                else m.scoreB = scoreVal;
                m.completed = (m.scoreA !== null && m.scoreB !== null);
            } else {
                const m = appState[catKey].knockout[matchKey];
                if (m) {
                    if (isTeamA) m.scoreA = scoreVal;
                    else m.scoreB = scoreVal;
                    m.completed = (m.scoreA !== null && m.scoreB !== null);
                }
            }

            saveAppState();
            renderView();
            showToast("토너먼트 결과가 업데이트되었습니다.");
        }

        // Modal Handler: Open Modal to Rename Teams
        function openTeamModal() {
            const container = document.getElementById('teamInputsContainer');
            container.innerHTML = '';
            const cfg = categoryConfigs[currentCategory];

            if (cfg.type === 'single_league' || cfg.type === 'final_only') {
                const currentTeams = appState[currentCategory].teams;
                let html = `<h4 class="font-bold text-sm text-slate-700 border-b pb-2 mb-3">팀 이름 변경</h4>`;
                currentTeams.forEach((team, idx) => {
                    html += `
                        <div class="flex items-center gap-3">
                            <span class="text-xs font-bold text-slate-500 w-12">팀 ${idx + 1}</span>
                            <input type="text" value="${team}" data-team-index="${idx}" 
                                class="team-name-input flex-1 px-3 py-2 border border-slate-300 rounded-xl text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-emerald-500">
                        </div>
                    `;
                });
                container.innerHTML = html;
            } else {
                let html = '';
                appState[currentCategory].groups.forEach((g, gIdx) => {
                    html += `<h4 class="font-bold text-sm text-slate-700 border-b pb-1 mt-4 mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-users text-emerald-600"></i> ${g.name} 팀 구성
                    </h4>`;
                    g.teams.forEach((team, tIdx) => {
                        html += `
                            <div class="flex items-center gap-3 mb-2">
                                <span class="text-xs font-bold text-slate-500 w-16">${g.name} ${tIdx + 1}</span>
                                <input type="text" value="${team}" data-group-index="${gIdx}" data-team-index="${tIdx}" 
                                    class="group-team-name-input flex-1 px-3 py-2 border border-slate-300 rounded-xl text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            </div>
                        `;
                    });
                });
                container.innerHTML = html;
            }

            document.getElementById('teamModal').classList.remove('hidden');
        }

        function closeTeamModal() {
            document.getElementById('teamModal').classList.add('hidden');
        }

        // Save Custom Team Names and regenerate schedule with new team names
        function saveTeamNames() {
            const cfg = categoryConfigs[currentCategory];

            if (cfg.type === 'single_league') {
                const inputs = document.querySelectorAll('.team-name-input');
                const oldTeams = [...appState.elem_m.teams];
                const newTeams = [];
                inputs.forEach(input => newTeams.push(input.value.trim() || '팀'));
                const rename = Object.fromEntries(oldTeams.map((name, i) => [name, newTeams[i]]));
                appState.elem_m.teams = newTeams;
                appState.elem_m.matches.forEach(m => {
                    m.teamA = rename[m.teamA] || m.teamA;
                    m.teamB = rename[m.teamB] || m.teamB;
                });

            } else if (cfg.type === 'final_only') {
                const inputs = document.querySelectorAll('.team-name-input');
                const newTeams = [];
                inputs.forEach(input => newTeams.push(input.value.trim() || '팀'));
                appState.elem_w.teams = newTeams;
                appState.elem_w.finalMatch.teamA = newTeams[0];
                appState.elem_w.finalMatch.teamB = newTeams[1];

            } else if (cfg.type === 'groups_with_semis' || cfg.type === 'groups_with_final') {
                const inputs = document.querySelectorAll('.group-team-name-input');
                const renameMaps = appState[currentCategory].groups.map(() => ({}));
                inputs.forEach(input => {
                    const gIdx = parseInt(input.getAttribute('data-group-index'));
                    const tIdx = parseInt(input.getAttribute('data-team-index'));
                    const group = appState[currentCategory].groups[gIdx];
                    const oldName = group.teams[tIdx];
                    const newName = input.value.trim() || '팀';
                    renameMaps[gIdx][oldName] = newName;
                    group.teams[tIdx] = newName;
                });
                appState[currentCategory].groups.forEach((g, idx) => {
                    const rename = renameMaps[idx];
                    g.matches.forEach(m => {
                        m.teamA = rename[m.teamA] || m.teamA;
                        m.teamB = rename[m.teamB] || m.teamB;
                    });
                });
            }

            saveAppState();
            closeTeamModal();
            renderView();
            showToast("팀 이름 변경사항이 반영되었습니다.");
        }

        // Reset All Tournament Data to Initial Default
        function resetData() {
            if (confirm("모든 경기 스코어와 설정된 팀 이름이 초기화됩니다. 계속하시겠습니까?")) {
                localStorage.removeItem(LOCAL_STORAGE_KEY);
                LEGACY_STORAGE_KEYS.forEach(key => localStorage.removeItem(key));
                buildDefaultState(true);
                renderView();
                showToast("모든 데이터가 초기화되었습니다.");
            }
        }

        // Export Standings and Results summary text for Sharing (KakaoTalk / SMS)
        function exportData() {
            const cfg = categoryConfigs[currentCategory];
            let shareText = `🏆 [실시간 대회 결과 - ${cfg.name}]\n`;
            shareText += `----------------------------------------\n`;

            if (cfg.type === 'single_league') {
                const standings = calculateStandings(appState.elem_m.teams, appState.elem_m.matches);
                shareText += `📊 [실시간 순위표]\n`;
                standings.forEach((s, idx) => {
                    shareText += `${idx + 1}위: ${s.team} | ${s.points}점 (득실 ${s.gd > 0 ? '+' : ''}${s.gd})\n`;
                });
            } else if (cfg.type === 'final_only') {
                const m = appState.elem_w.finalMatch;
                shareText += `⚽ [단판 결승전]\n`;
                shareText += `${m.matchDate || '날짜 미정'} ${m.matchTime || '시간 미정'} | HOME ${m.teamA} ${m.scoreA !== null ? m.scoreA : '-'} : ${m.scoreB !== null ? m.scoreB : '-'} ${m.teamB} AWAY\n`;
            } else if (cfg.type === 'groups_with_semis' || cfg.type === 'groups_with_final') {
                appState[currentCategory].groups.forEach(g => {
                    const standings = calculateStandings(g.teams, g.matches);
                    shareText += `📌 [${g.name} 순위]\n`;
                    standings.forEach((s, idx) => {
                        shareText += `  ${idx + 1}위: ${s.team} (${s.points}점, 득실 ${s.gd > 0 ? '+' : ''}${s.gd})\n`;
                    });
                });

                shareText += `\n🏆 [본선 결과]\n`;
                const ko = appState[currentCategory].knockout;
                if (ko.semi1) {
                    shareText += `준결승1: ${ko.semi1.teamA} ${ko.semi1.scoreA ?? '-'} : ${ko.semi1.scoreB ?? '-'} ${ko.semi1.teamB}\n`;
                    shareText += `준결승2: ${ko.semi2.teamA} ${ko.semi2.scoreA ?? '-'} : ${ko.semi2.scoreB ?? '-'} ${ko.semi2.teamB}\n`;
                }
                shareText += `결승전: ${ko.final.teamA} ${ko.final.scoreA ?? '-'} : ${ko.final.scoreB ?? '-'} ${ko.final.teamB}\n`;
            }

            shareText += `----------------------------------------\n▶ 실시간 대진표 웹 공유 중`;

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(shareText).then(() => {
                    showToast("대회 결과 텍스트가 클립보드에 복사되었습니다!");
                }).catch(() => {
                    fallbackCopyText(shareText);
                });
            } else {
                fallbackCopyText(shareText);
            }
        }

        function fallbackCopyText(text) {
            const textarea = document.createElement("textarea");
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand("copy");
            document.body.removeChild(textarea);
            showToast("대회 결과 텍스트가 클립보드에 복사되었습니다!");
        }

        // Show Toast Notification
        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Run application on page load
        window.onload = function() {
            initApp();
        };
    </script>
</body>
</html>
