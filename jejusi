        // Calculate League Standings with official tiebreakers
        // 1. Points, 2. Goal Difference, 3. Goals For, 4. Head-to-Head
        function calculateStandings(teams, matches) {
            const stats = {};
            teams.forEach(team => {
                stats[team] = {
                    team: team,
                    played: 0,
                    won: 0,
                    drawn: 0,
                    lost: 0,
                    gf: 0,
                    ga: 0,
                    gd: 0,
                    points: 0
                };
            });

            matches.forEach(m => {
                if (m.completed && m.scoreA !== null && m.scoreB !== null) {
                    const sa = parseInt(m.scoreA);
                    const sb = parseInt(m.scoreB);
                    const tA = m.teamA;
                    const tB = m.teamB;

                    if (stats[tA] && stats[tB]) {
                        stats[tA].played++;
                        stats[tB].played++;
                        stats[tA].gf += sa;
                        stats[tA].ga += sb;
                        stats[tB].gf += sb;
                        stats[tB].ga += sa;

                        if (sa > sb) {
                            stats[tA].won++;
                            stats[tA].points += 3;
                            stats[tB].lost++;
                        } else if (sb > sa) {
                            stats[tB].won++;
                            stats[tB].points += 3;
                            stats[tA].lost++;
                        } else {
                            stats[tA].drawn++;
                            stats[tA].points += 1;
                            stats[tB].drawn++;
                            stats[tB].points += 1;
                        }
                    }
                }
            });

            Object.keys(stats).forEach(t => {
                stats[t].gd = stats[t].gf - stats[t].ga;
            });

            const standings = Object.values(stats);

            standings.sort((a, b) => {
                if (b.points !== a.points) return b.points - a.points;
                if (b.gd !== a.gd) return b.gd - a.gd;
                if (b.gf !== a.gf) return b.gf - a.gf;

                // Head to head check
                const h2h = matches.find(m => 
                    m.completed && 
                    ((m.teamA === a.team && m.teamB === b.team) || (m.teamA === b.team && m.teamB === a.team))
                );
                if (h2h && h2h.scoreA !== null && h2h.scoreB !== null) {
                    if (h2h.teamA === a.team && h2h.scoreA > h2h.scoreB) return -1;
                    if (h2h.teamA === a.team && h2h.scoreB > h2h.scoreA) return 1;
                    if (h2h.teamB === a.team && h2h.scoreB > h2h.scoreA) return -1;
                    if (h2h.teamB === a.team && h2h.scoreA > h2h.scoreB) return 1;
                }
                return 0;
            });

            return standings;
        }

