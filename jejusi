<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>실시간 축구 대진표 & 순위표 v5.0</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- MQTT.js: shared real-time synchronization -->
    <script src="https://unpkg.com/mqtt/dist/mqtt.min.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Sans KR', sans-serif;
            background-color: #f8fafc;
        }
        .table-container::-webkit-scrollbar {
            height: 6px;
        }
        .table-container::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen pb-16">

    <!-- Header -->
    <header class="bg-emerald-700 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8">
            <div class="flex flex-col sm:flex-row justify-between items-center gap-3">
                <div class="flex items-center space-x-3">
                    <div class="bg-emerald-600 p-2.5 rounded-xl border border-emerald-500 shadow-inner">
                        <i class="fa-solid fa-trophy text-2xl text-amber-300"></i>
                    </div>
                    <div>
                        <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight">대회 실시간 대진표 및 순위</h1>
                        <p class="text-xs text-emerald-100">날짜·시간 · HOME/AWAY · 실시간 공동입력 · 승점 순위</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 flex-wrap justify-center sm:justify-end">
                    <div id="syncStatus" class="inline-flex items-center gap-1.5 px-2.5 py-2 rounded-lg bg-emerald-800 border border-emerald-600 text-[11px] font-semibold text-emerald-100" title="실시간 공동입력 연결 상태">
                        <span id="syncDot" class="w-2 h-2 rounded-full bg-amber-300"></span>
                        <span id="syncText">실시간 연결 중</span>
                    </div>
                    <span class="inline-flex items-center px-2.5 py-2 rounded-lg bg-emerald-950/40 border border-emerald-500/50 text-[11px] font-black text-emerald-100" title="앱/데이터 스키마 버전">v5.0</span>
                    <button id="resetDataBtn" onclick="resetData()" class="bg-emerald-800 hover:bg-emerald-900 text-xs text-emerald-100 font-semibold py-2 px-3 rounded-lg transition border border-emerald-600 flex items-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-rotate-right"></i> 데이터 초기화
                    </button>
                    <button id="exportDataBtn" onclick="exportData()" class="bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold text-xs py-2 px-3.5 rounded-lg transition flex items-center gap-1.5 shadow-md">
                        <i class="fa-solid fa-share-nodes"></i> 결과 복사 & 공유
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Category Navigation Tabs -->
        <div class="bg-emerald-800/90 backdrop-blur border-t border-emerald-600/50">
            <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8 flex overflow-x-auto space-x-1 py-2 text-sm font-medium no-scrollbar">
                <button onclick="switchCategory('elem_m')" id="tab-elem_m" class="category-tab px-4 py-2 rounded-lg text-emerald-100 hover:bg-emerald-700/60 transition whitespace-nowrap flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-400"></span>
                    남초부 (3팀)
                </button>
                <button onclick="switchCategory('elem_w')" id="tab-elem_w" class="category-tab px-4 py-2 rounded-lg text-emerald-100 hover:bg-emerald-700/60 transition whitespace-nowrap flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-pink-400"></span>
                    여초부 (2팀 · 결승)
                </button>
                <button onclick="switchCategory('mid_m')" id="tab-mid_m" class="category-tab px-4 py-2 rounded-lg text-emerald-100 hover:bg-emerald-700/60 transition whitespace-nowrap flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-indigo-400"></span>
                    남중부 (14팀 · 4개조+4강)
                </button>
                <button onclick="switchCategory('mid_w')" id="tab-mid_w" class="category-tab px-4 py-2 rounded-lg text-emerald-100 hover:bg-emerald-700/60 transition whitespace-nowrap flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-rose-400"></span>
                    여중부 (7팀 · 2개조+결승)
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">

        <!-- Category Banner Info -->
        <div id="categoryHeader" class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200/80 mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span id="categoryBadge" class="inline-block px-3 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-700">남초부</span>
                    <span id="categoryRuleNotice" class="text-xs bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full font-medium">풀리그 방식</span>
                </div>
                <h2 id="categoryTitle" class="text-2xl font-bold text-slate-800">남자 초등학교 리그 경기</h2>
                <p id="categoryDesc" class="text-sm text-slate-500 mt-1">총 3팀 참여 | 3경기 (풀리그)</p>
            </div>
            
            <div class="flex items-center gap-2 self-stretch sm:self-auto">
                <button onclick="openTeamModal()" class="flex-1 sm:flex-initial bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold py-2.5 px-4 rounded-xl transition flex items-center justify-center gap-2 border border-slate-300 shadow-sm">
                    <i class="fa-solid fa-pen-to-square"></i> 팀 이름 수정하기
                </button>
            </div>
        </div>

        <!-- Rules Info Banner -->
        <div class="bg-amber-50/80 border border-amber-200 rounded-xl p-3.5 mb-6 text-xs text-amber-900 flex flex-col md:flex-row md:items-center justify-between gap-2">
            <div class="flex items-start gap-2">
                <i class="fa-solid fa-circle-info text-amber-600 text-base mt-0.5"></i>
                <div>
                    <span class="font-bold text-amber-950">리그 순위 결정 우선순위 규정:</span>
                    <span class="ml-1 text-amber-800">① 승점 (승3, 무1, 패0) ➜ ② 득실차 ➜ ③ 다득점 ➜ ④ 승자승 (맞대결 결과) ➜ ⑤ 동률 시 추첨</span>
                </div>
            </div>
        </div>

        <!-- Main Dynamic View Container -->
        <div id="mainViewContainer" class="space-y-8">
            <!-- Dynamic Rendered Content (Standings + Matches / Tournament) -->
        </div>

    </main>

    <!-- Modal: Edit Team Names -->
    <div id="teamModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg overflow-hidden transform transition-all">
            <div class="p-5 bg-slate-800 text-white flex justify-between items-center">
                <h3 class="font-bold text-lg flex items-center gap-2">
                    <i class="fa-solid fa-users-gear text-emerald-400"></i> 참가 팀 이름 설정
                </h3>
                <button onclick="closeTeamModal()" class="text-slate-400 hover:text-white transition">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
            <div class="p-5 max-h-[60vh] overflow-y-auto space-y-4" id="teamInputsContainer">
                <!-- Inputs injected dynamically -->
            </div>
            <div class="p-4 bg-slate-50 border-t border-slate-200 flex justify-end gap-2">
                <button onclick="closeTeamModal()" class="px-4 py-2 rounded-xl text-slate-600 text-sm font-semibold hover:bg-slate-200 transition">취소</button>
                <button onclick="saveTeamNames()" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold transition shadow-md">저장하기</button>
            </div>
        </div>
    </div>

    <!-- Alert / Toast Modal -->
    <div id="toast" class="fixed bottom-6 right-6 bg-slate-900 text-white px-5 py-3 rounded-xl shadow-2xl z-50 flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300">
        <i class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
        <span id="toastMsg" class="text-sm font-medium">메시지 내용</span>
    </div>

    <script>
        // Category Standard Configuration
        const categoryConfigs = {
            elem_m: {
                name: "남자 초등학교",
                badge: "남초부",
                badgeColor: "bg-blue-100 text-blue-700",
                type: "single_league",
                teams: ["해돌초", "꿈나무초", "새싹초"]
            },
            elem_w: {
                name: "여자 초등학교",
                badge: "여초부",
                badgeColor: "bg-pink-100 text-pink-700",
                type: "final_only",
                teams: ["미래초", "한별초"]
            },
            mid_m: {
                name: "남자 중학교",
                badge: "남중부",
                badgeColor: "bg-indigo-100 text-indigo-700",
                type: "groups_with_semis",
                groups: [
                    { name: "A조", count: 4, teams: ["남중 1", "남중 2", "남중 3", "남중 4"], matchesType: "4teams" },
                    { name: "B조", count: 4, teams: ["남중 5", "남중 6", "남중 7", "남중 8"], matchesType: "4teams" },
                    { name: "C조", count: 3, teams: ["남중 9", "남중 10", "남중 11"], matchesType: "3teams" },
                    { name: "D조", count: 3, teams: ["남중 12", "남중 13", "남중 14"], matchesType: "3teams" }
                ]
            },
            mid_w: {
                name: "여자 중학교",
                badge: "여중부",
                badgeColor: "bg-rose-100 text-rose-700",
                type: "groups_with_final",
                groups: [
                    { name: "A조", count: 4, teams: ["여중 A1", "여중 A2", "여중 A3", "여중 A4"], matchesType: "4teams" },
                    { name: "B조", count: 3, teams: ["여중 B1", "여중 B2", "여중 B3"], matchesType: "3teams" }
                ]
            }
        };

        let currentCategory = 'elem_m';
        let appState = {};

        // Shared real-time state. All visitors to the published tournament page use the same topic.
        // A long opaque suffix keeps accidental cross-talk with other public-broker users unlikely.
        const APP_VERSION = '5.0.0';
        const DATA_SCHEMA_VERSION = 5;
        const LOCAL_STORAGE_KEY = 'soccer_tournament_realtime_v5';
        const LEGACY_STORAGE_KEYS = ['soccer_tournament_realtime_v4', 'soccer_tournament_v2'];
        const REALTIME_BROKER = 'wss://broker.emqx.io:8084/mqtt';
        const REALTIME_TOPIC = 'jeju-school-soccer/kickoff-namcho-league-1103/9f8c1e7b4a6d43a1b8e2/state';
        const CLIENT_ID = 'kickoff_' + Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-5);
        let syncClient = null;
        let syncConnected = false;
        let syncReady = false;
        let receivedRetainedState = false;
        let dirtyWhileOffline = false;
        let stateUpdatedAt = 0;
        let applyingRemoteState = false;

        function initApp() {
            loadLocalState();
            migrateStateShape(window.__loadedSchemaVersion || 0);
            switchCategory(currentCategory);
            connectRealtime();
        }

        function loadLocalState() {
            const saved = localStorage.getItem(LOCAL_STORAGE_KEY);
            const legacy = LEGACY_STORAGE_KEYS.map(key => localStorage.getItem(key)).find(Boolean);
            const raw = saved || legacy;
            if (!raw) {
                buildDefaultState(false);
                return;
            }

            try {
                const parsed = JSON.parse(raw);
                if (parsed && parsed.state && typeof parsed.state === 'object') {
                    appState = parsed.state;
                    stateUpdatedAt = Number(parsed.updatedAt) || 0;
                    window.__loadedSchemaVersion = Number(parsed.schemaVersion) || 0;
                } else {
                    appState = parsed;
                    stateUpdatedAt = 0;
                    window.__loadedSchemaVersion = 0;
                }
            } catch (e) {
                console.error('Failed to load saved state', e);
                buildDefaultState(false);
            }
        }

        function migrateStateShape(fromSchemaVersion = 0) {
            const touchMatch = (m) => {
                if (!m) return;
                if (typeof m.matchDate !== 'string') m.matchDate = '';
                if (typeof m.matchTime !== 'string') m.matchTime = '';
                if (typeof m.completed !== 'boolean') m.completed = (m.scoreA !== null && m.scoreB !== null);
            };

            (appState.elem_m?.matches || []).forEach(touchMatch);
            touchMatch(appState.elem_w?.finalMatch);
            ['mid_m', 'mid_w'].forEach(cat => {
                (appState[cat]?.groups || []).forEach(g => (g.matches || []).forEach(touchMatch));
                Object.values(appState[cat]?.knockout || {}).forEach(touchMatch);
            });
            // Schema migrations are intentionally additive: never recreate fixtures here.
            // This preserves team names, scores, dates and times across upgrades.
            window.__loadedSchemaVersion = DATA_SCHEMA_VERSION;
            persistLocalState();
        }

        function setSyncStatus(mode, text) {
            const dot = document.getElementById('syncDot');
            const label = document.getElementById('syncText');
            if (!dot || !label) return;
            dot.className = 'w-2 h-2 rounded-full ' + (mode === 'online' ? 'bg-lime-300' : mode === 'error' ? 'bg-rose-300' : 'bg-amber-300');
            label.textContent = text;
        }

        function connectRealtime() {
            if (!window.mqtt || typeof window.mqtt.connect !== 'function') {
                setSyncStatus('error', '실시간 서버 불러오기 실패');
                return;
            }

            try {
                syncClient = window.mqtt.connect(REALTIME_BROKER, {
                    clientId: CLIENT_ID,
                    clean: true,
                    reconnectPeriod: 2000,
                    connectTimeout: 10000,
                    keepalive: 30
                });

                syncClient.on('connect', () => {
                    syncConnected = true;
                    syncReady = false;
                    receivedRetainedState = false;
                    setSyncStatus('waiting', '공동 기록 불러오는 중');
                    syncClient.subscribe(REALTIME_TOPIC, { qos: 1 }, (err) => {
                        if (err) {
                            setSyncStatus('error', '실시간 구독 실패');
                            return;
                        }
                        // If there is no retained shared state yet, seed the room with this browser's state.
                        setTimeout(() => {
                            if (!receivedRetainedState) {
                                syncReady = true;
                                if (!stateUpdatedAt) stateUpdatedAt = Date.now();
                                publishSharedState();
                            }
                        }, 1000);
                    });
                });

                syncClient.on('message', (topic, payload) => {
                    if (topic !== REALTIME_TOPIC) return;
                    try {
                        const msg = JSON.parse(payload.toString());
                        if (!msg || !msg.state || typeof msg.state !== 'object') return;
                        receivedRetainedState = true;
                        syncReady = true;

                        const remoteUpdatedAt = Number(msg.updatedAt) || 0;
                        const localIsNewer = dirtyWhileOffline && stateUpdatedAt > remoteUpdatedAt;
                        if (localIsNewer) {
                            publishSharedState();
                        } else if (msg.writer !== CLIENT_ID && remoteUpdatedAt >= stateUpdatedAt) {
                            applyingRemoteState = true;
                            appState = msg.state;
                            stateUpdatedAt = remoteUpdatedAt;
                            migrateStateShape(Number(msg.schemaVersion) || 0);
                            persistLocalState();
                            applyingRemoteState = false;
                            renderView();
                        }
                        dirtyWhileOffline = false;
                        setSyncStatus('online', '실시간 공동입력 연결됨');
                    } catch (e) {
                        console.warn('Invalid shared state message', e);
                    }
                });

                syncClient.on('reconnect', () => {
                    syncConnected = false;
                    syncReady = false;
                    setSyncStatus('waiting', '실시간 재연결 중');
                });
                syncClient.on('offline', () => {
                    syncConnected = false;
                    setSyncStatus('waiting', '오프라인 · 자동 재연결');
                });
                syncClient.on('close', () => {
                    syncConnected = false;
                });
                syncClient.on('error', (err) => {
                    console.warn('Realtime sync error', err);
                    setSyncStatus('error', '실시간 연결 오류');
                });
            } catch (e) {
                console.error(e);
                setSyncStatus('error', '실시간 연결 실패');
            }
        }

        function persistLocalState() {
            const stored = {
                appVersion: APP_VERSION,
                schemaVersion: DATA_SCHEMA_VERSION,
                updatedAt: stateUpdatedAt,
                state: appState
            };
            localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(stored));
            // Keep v4-compatible snapshots so an older published copy can still read the latest state.
            localStorage.setItem('soccer_tournament_realtime_v4', JSON.stringify(stored));
            localStorage.setItem('soccer_tournament_v2', JSON.stringify(appState));
        }

        function publishSharedState() {
            if (!syncClient || !syncConnected || !syncReady) {
                dirtyWhileOffline = true;
                return;
            }
            const envelope = JSON.stringify({
                appVersion: APP_VERSION,
                schemaVersion: DATA_SCHEMA_VERSION,
                updatedAt: stateUpdatedAt || Date.now(),
                writer: CLIENT_ID,
                state: appState
            });
            syncClient.publish(REALTIME_TOPIC, envelope, { qos: 1, retain: true }, (err) => {
                if (err) {
                    dirtyWhileOffline = true;
                    setSyncStatus('error', '저장 재시도 중');
                } else {
                    dirtyWhileOffline = false;
                    setSyncStatus('online', '실시간 공동입력 연결됨');
                }
            });
        }

        function buildDefaultState(broadcast = true) {
            appState = {};

            // 1. Male Elementary (3 teams single league)
            appState.elem_m = {
                teams: [...categoryConfigs.elem_m.teams],
                matches: generateGroupFixtures(categoryConfigs.elem_m.teams, 'elem_m')
            };

            // 2. Female Elementary (2 teams single final match)
            appState.elem_w = {
                teams: [...categoryConfigs.elem_w.teams],
                finalMatch: {
                    id: 'elem_w_final',
                    teamA: categoryConfigs.elem_w.teams[0],
                    teamB: categoryConfigs.elem_w.teams[1],
                    scoreA: null,
                    scoreB: null,
                    matchDate: '',
                    matchTime: '',
                    completed: false
                }
            };

            // 3. Male Middle School (14 teams: A:4, B:4, C:3, D:3)
            appState.mid_m = {
                groups: categoryConfigs.mid_m.groups.map((g, idx) => ({
                    id: `mid_m_g_${idx}`,
                    name: g.name,
                    teams: [...g.teams],
                    matches: generateGroupFixtures(g.teams, `mid_m_g_${idx}`)
                })),
                knockout: {
                    semi1: { id: 'mid_m_semi1', name: '준결승 1경기 (A조 1위 vs B조 1위)', teamA: 'A조 1위', teamB: 'B조 1위', scoreA: null, scoreB: null, matchDate: '', matchTime: '', completed: false },
                    semi2: { id: 'mid_m_semi2', name: '준결승 2경기 (C조 1위 vs D조 1위)', teamA: 'C조 1위', teamB: 'D조 1위', scoreA: null, scoreB: null, matchDate: '', matchTime: '', completed: false },
                    final: { id: 'mid_m_final', name: '남중부 결승전', teamA: '준결승 1 승자', teamB: '준결승 2 승자', scoreA: null, scoreB: null, matchDate: '', matchTime: '', completed: false }
                }
            };

            // 4. Female Middle School (7 teams: A:4, B:3)
            appState.mid_w = {
                groups: categoryConfigs.mid_w.groups.map((g, idx) => ({
                    id: `mid_w_g_${idx}`,
                    name: g.name,
                    teams: [...g.teams],
                    matches: generateGroupFixtures(g.teams, `mid_w_g_${idx}`)
                })),
                knockout: {
                    final: { id: 'mid_w_final', name: '여중부 결승전 (A조 1위 vs B조 1위)', teamA: 'A조 1위', teamB: 'B조 1위', scoreA: null, scoreB: null, matchDate: '', matchTime: '', completed: false }
                }
            };

            saveAppState(broadcast);
        }

        // Generate Fixtures:
        // 4 teams -> 4 matches: (Team 1 vs Team 2), (Team 3 vs Team 4), (Team 1 vs Team 3), (Team 2 vs Team 4)
        // 3 teams -> 3 matches: (Team 1 vs Team 2), (Team 2 vs Team 3), (Team 3 vs Team 1)
        function generateGroupFixtures(teams, prefix = 'm') {
            const matches = [];
            const n = teams.length;

            if (n === 4) {
                matches.push(
                    { id: `${prefix}_1`, round: 1, teamA: teams[0], teamB: teams[1], scoreA: null, scoreB: null, matchDate: '', matchTime: '', completed: false },
                    { id: `${prefix}_2`, round: 1, teamA: teams[2], teamB: teams[3], scoreA: null, scoreB: null, matchDate: '', matchTime: '', completed: false },
                    { id: `${prefix}_3`, round: 2, teamA: teams[0], teamB: teams[2], scoreA: null, scoreB: null, matchDate: '', matchTime: '', completed: false },
                    { id: `${prefix}_4`, round: 2, teamA: teams[1], teamB: teams[3], scoreA: null, scoreB: null, matchDate: '', matchTime: '', completed: false }
                );
            } else if (n === 3) {
                matches.push(
                    { id: `${prefix}_1`, round: 1, teamA: teams[0], teamB: teams[1], scoreA: null, scoreB: null, matchDate: '', matchTime: '', completed: false },
                    { id: `${prefix}_2`, round: 2, teamA: teams[1], teamB: teams[2], scoreA: null, scoreB: null, matchDate: '', matchTime: '', completed: false },
                    { id: `${prefix}_3`, round: 3, teamA: teams[2], teamB: teams[0], scoreA: null, scoreB: null, matchDate: '', matchTime: '', completed: false }
                );
            }
            return matches;
        }

        function saveAppState(broadcast = true) {
            if (!applyingRemoteState) stateUpdatedAt = Date.now();
            persistLocalState();
            if (broadcast && !applyingRemoteState) publishSharedState();
        }

